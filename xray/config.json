{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 3000,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${CLIENT_ID}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "host": "${DOMAIN_URL}",
          "path": "/public",
          "mode": "packet-up",
          "extra": {
            "headers": {
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:145.0) Gecko/20100101 Firefox/145.0",
              "Accept": "*/*",
              "Accept-Language": "ru-RU,ru;q=0.8,en-US;q=0.5,en;q=0.3",
              "Accept-Encoding": "gzip, deflate, br, zstd",
              "Content-Type": "application/octet-stream"
            },
            "xPaddingBytes": "100-1000",
            "noSSEHeader": false,
            "scMaxEachPostBytes": 2000000,
            "scMaxBufferedPosts": 50
          }
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "warp",
      "protocol": "socks",
      "settings": {
        "address": "warp",
        "port": 1080
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "domain": [
          "geoip:ru"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "geosite:youtube"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:google"
        ],
        "outboundTag": "warp"
      }
    ]
  }
}